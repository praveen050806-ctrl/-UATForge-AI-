# UATForge AI — Environment Configuration Template
# Copy this file to .env.local for local development.
# Do NOT commit sensitive keys or credentials to version control.

# Application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Google Gemini API Configuration (Deferred to Milestone 2)
# GEMINI_API_KEY=your_gemini_api_key_here

# MongoDB Database Configuration (Deferred to Milestone 2)
# MONGODB_URI=mongodb://localhost:27017/uatforge
# MONGODB_DB=uatforge
